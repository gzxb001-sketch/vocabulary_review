# ===== 数据库（Turso / libsql）=====
# 本地开发可改用 SQLite 文件：DATABASE_URL="file:./dev.db"
DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ===== JWT 鉴权 =====
# 生产环境必须配置强随机密钥（推荐 crypto.randomBytes(64).toString('hex') 生成）
# 本地开发可留空，代码会回退到开发用固定密钥
JWT_SECRET="generate-a-64-byte-hex-secret"

# ===== Web Push (VAPID) =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"

# ===== 邮件提醒（QQ 邮箱 SMTP 示例）=====
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-auth-code"
SMTP_FROM="竹墨词库 <you@example.com>"
